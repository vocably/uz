{"transcript":"bɒʃqaˈruv","exists":true,"definitions":["Biror narsani boshqarish, yoʻnaltirish yoki nazorat qilish harakati.","Tashkilot, davlat yoki tizimni boshqarish tizimi yoki jarayoni.","Maʼmuriy yoki ijro etuvchi organ."],"examples":["Davlat boshqaruvi.","Korxona boshqaruvi.","Samarali boshqaruv.","Boshqaruv tizimi."],"lemma":"boshqarmoq","lemmaPos":"verb","synonyms":["idora","nazorat","menejment"],"number":"singular","pluralForm":"boshqaruvlar","source":"boshqaruv","frequency":7}